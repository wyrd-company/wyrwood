{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wyrd.foo/wyrwood/schemas/controller-configuration.json",
  "title": "Wyrwood controller configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["openbao", "oidc"],
  "properties": {
    "local-agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      }
    },
    "update-checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "interval": { "type": "string", "default": "24h" },
        "timeout": { "type": "string", "default": "10s" }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": { "type": "string", "default": "127.0.0.1:8080" },
        "session-ttl": { "type": "string", "default": "12h" }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": { "type": "string", "default": "0.0.0.0:2222" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string", "default": "/var/lib/wyrwood" }
      }
    },
    "openbao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "approle"],
      "properties": {
        "address": { "type": "string", "format": "uri" },
        "ca-file": { "type": "string" },
        "namespace": { "type": "string" },
        "approle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role-id", "secret-id-file"],
          "properties": {
            "mount": { "type": "string", "default": "approle" },
            "role-id": { "type": "string" },
            "secret-id-file": { "type": "string" }
          }
        },
        "transit-mount": { "type": "string", "default": "transit" },
        "ssh-mount": { "type": "string", "default": "ssh" },
        "secret-mounts": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$",
                "not": {
                  "anyOf": [
                    { "const": "." },
                    { "pattern": "\\.\\." },
                    { "enum": ["sys", "auth", "identity", "cubbyhole", "audit"] }
                  ]
                }
              },
              "type": { "enum": ["kv-v2", "other"] }
            }
          }
        },
        "ui-url": { "type": "string", "format": "uri" }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "client-id",
        "client-secret-file",
        "redirect-url",
        "allowed-groups"
      ],
      "properties": {
        "provider-name": {
          "type": "string",
          "maxLength": 64,
          "default": "your identity provider"
        },
        "issuer": { "type": "string", "format": "uri" },
        "client-id": { "type": "string" },
        "client-secret-file": { "type": "string" },
        "redirect-url": { "type": "string", "format": "uri" },
        "groups-claim": { "type": "string", "default": "groups" },
        "allowed-groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
