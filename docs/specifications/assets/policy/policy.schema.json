{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wyrd.foo/wyrwood/schemas/policy.json",
  "title": "Wyrwood policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "openbao",
    "contract"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "openbao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "maxLength": 65536
        },
        "agent-token-renewal": {
          "type": "boolean",
          "description": "Enable actual agent renewal of the binding token. Any selected policy enabling renewal enables it for the binding."
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transit-keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "ca-roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "not-forwardable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transit-keys": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/name"
              },
              "uniqueItems": true,
              "maxItems": 64
            },
            "ca-roles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/name"
              },
              "uniqueItems": true,
              "maxItems": 64
            }
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount-target"
      ],
      "properties": {
        "mount-target": {
          "type": "string",
          "pattern": "^/"
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "maxProperties": 64
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "maxLength": 128
    }
  }
}
